---
import AlumniSpotlight from '@/components/AlumniSpotlight.astro';
import Hero from '@/components/Hero.astro';
import PillarGrid from '@/components/PillarGrid.astro';
import PostCard from '@/components/PostCard.astro';
import Section from '@/components/Section.astro';
import StatGrid from '@/components/StatGrid.astro';
import type { Locale } from '@/i18n/config';
import { path, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getOrganizations, getPage, getPosts } from '@/lib/content';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const pageEntry = await getPage('home', locale);
const data = pageEntry.data;
const recentPosts = (await getPosts(locale)).slice(0, 3);
const allOrgs = await getOrganizations({ activeOnly: true });
---

<BaseLayout
  locale={locale}
  title={data.hero.title}
  description={data.hero.subtitle}
  routeKey="home"
  image={data.hero.image}
>
  <!-- 1. Hero Section (Media Kit Coral) -->
  <Hero
    badge={data.hero.badge}
    title={data.hero.title}
    subtitle={data.hero.subtitle}
    image={data.hero.image}
    primaryCta={data.hero.cta}
    secondaryCta={data.hero.secondaryCta}
    variant="coral"
  />

  <!-- 2. Impact Numbers Band -->
  <Section bg="warm" class="py-10 sm:py-12">
    <StatGrid stats={data.stats} />
  </Section>

  <!-- 3. Mission & 4 Program Pillars -->
  <Section
    tag={data.mission.tag}
    title={data.mission.title}
    intro={data.mission.body}
    bg="white"
  >
    <PillarGrid pillars={data.pillars} />
  </Section>

  <!-- 4. Alumni Callout -->
  {
    data.alumniCallout && (
      <Section bg="warm">
        <AlumniSpotlight
          badge={data.alumniCallout.badge}
          title={data.alumniCallout.title}
          story={data.alumniCallout.story}
          cta={data.alumniCallout.cta}
        />
      </Section>
    )
  }

  <!-- 5. Recent Blog Stories (Theater Outings, Anniversary Tournament) -->
  {
    recentPosts.length > 0 && (
      <Section
        tag="Blog"
        title={
          locale === 'pt-br'
            ? 'Vivências na areia, na biblioteca e no teatro'
            : 'Stories from the beach, library, and theater'
        }
        bg="white"
      >
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {recentPosts.map((post) => (
            <PostCard
              locale={locale}
              slug={post.slug}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              cover={post.data.cover}
              coverAlt={post.data.coverAlt}
              author={post.data.author}
            />
          ))}
        </div>
        <div class="mt-10 text-center">
          <a
            href={path('blog', locale)}
            class="border-ink/20 bg-surface-warm text-ink hover:bg-mint-400 hover:border-mint-400 inline-flex items-center gap-2 rounded-full border px-6 py-3 text-sm font-extrabold transition-colors"
          >
            <span>{t('action.viewAll')}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </Section>
    )
  }

  <!-- 6. Sponsors & Partners Band -->
  {
    allOrgs.length > 0 && (
      <Section title={data.sponsorBand.title} bg="warm">
        <div class="grid grid-cols-2 items-center gap-4 sm:grid-cols-3 lg:grid-cols-6">
          {allOrgs.map((org) => (
            <div class="border-ink/10 bg-surface flex items-center justify-center rounded-2xl border p-4 shadow-2xs">
              <img
                src={org.data.logo}
                alt={org.data.name}
                width="200"
                height="60"
                loading="lazy"
                decoding="async"
                class="h-12 w-auto object-contain"
              />
            </div>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a
            href={data.sponsorBand.cta.href}
            class="bg-ink hover:bg-coral-600 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-extrabold text-white transition-colors"
          >
            <span>{data.sponsorBand.cta.label}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </Section>
    )
  }

  <!-- 7. Donate Callout Band (Media Kit Coral) -->
  <Section bg="coral">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-4xl">
        {data.donateBand.title}
      </h2>
      <p class="mt-4 text-lg font-medium text-white/95">
        {data.donateBand.body}
      </p>
      <div class="mt-8">
        <a
          href={data.donateBand.cta.href}
          class="bg-sun-400 text-ink hover:bg-sun-500 inline-flex items-center gap-2 rounded-full px-8 py-4 text-base font-extrabold shadow-md transition-transform hover:scale-105"
        >
          <span aria-hidden="true">♥</span>
          <span>{data.donateBand.cta.label}</span>
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>
