---
import { render, type CollectionEntry } from 'astro:content';
import Prose from '@/components/Prose.astro';
import Section from '@/components/Section.astro';
import type { Locale } from '@/i18n/config';
import { formatDate, path, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPostBySlug } from '@/lib/content';

export interface Props {
  locale: Locale;
  post: CollectionEntry<'blog'> & { slug: string };
}

const { locale, post } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(post);

const otherLocale: Locale = locale === 'pt-br' ? 'en' : 'pt-br';
const translatedPost = await getPostBySlug(post.slug, otherLocale);
const availableLocales: Locale[] = translatedPost ? ['pt-br', 'en'] : [locale];
---

<BaseLayout
  locale={locale}
  title={post.data.title}
  description={post.data.description}
  routeKey="post"
  slug={post.slug}
  availableLocales={availableLocales}
  image={post.data.cover}
>
  <article>
    <header class="border-ink/10 bg-surface-warm border-b py-12 sm:py-16">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <a
          href={path('blog', locale)}
          class="text-coral-600 hover:text-coral-700 inline-flex items-center gap-1.5 text-xs font-extrabold tracking-wider uppercase"
        >
          <span aria-hidden="true">←</span>
          <span>{t('action.backToBlog')}</span>
        </a>

        <div
          class="text-mint-700 mt-4 flex flex-wrap items-center gap-2 text-xs font-semibold"
        >
          <span>{t('blog.publishedOn')}</span>
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate, locale)}
          </time>
          {
            post.data.author && (
              <>
                <span aria-hidden="true">•</span>
                <span>
                  {t('blog.by')} {post.data.author}
                </span>
              </>
            )
          }
        </div>

        <h1
          class="text-ink mt-3 text-3xl font-extrabold tracking-tight text-balance sm:text-4xl lg:text-5xl"
        >
          {post.data.title}
        </h1>
        <p class="text-ink-muted mt-4 text-lg leading-relaxed">
          {post.data.description}
        </p>

        {
          translatedPost && (
            <div class="border-mint-400/40 bg-mint-50 text-mint-800 mt-6 inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-xs font-bold">
              <span>🌐 {t('blog.availableInOtherLang')}</span>
              <a
                href={path('post', otherLocale, post.slug)}
                class="hover:text-ink underline"
              >
                {otherLocale === 'en'
                  ? 'Read in English →'
                  : 'Ler em Português →'}
              </a>
            </div>
          )
        }
      </div>
    </header>

    <Section bg="white" class="py-10 sm:py-14">
      <div class="mx-auto max-w-3xl">
        {
          post.data.cover && (
            <figure class="border-ink/10 mb-10 overflow-hidden rounded-3xl border shadow-sm">
              <img
                src={post.data.cover}
                alt={post.data.coverAlt || post.data.title}
                width="800"
                height="500"
                loading="eager"
                decoding="async"
                class="aspect-16/10 w-full object-cover"
              />
            </figure>
          )
        }

        <Prose>
          <Content />
        </Prose>

        <div
          class="border-ink/10 bg-surface-warm mt-14 flex flex-col items-center justify-between gap-4 rounded-3xl border p-6 sm:flex-row"
        >
          <div>
            <p class="text-ink text-sm font-extrabold">
              {
                locale === 'pt-br'
                  ? 'Gostou de acompanhar nosso trabalho?'
                  : 'Inspired by our students and community?'
              }
            </p>
            <p class="text-ink-muted text-xs">
              {
                locale === 'pt-br'
                  ? 'Ajude a manter nossas aulas, refeições e passeios culturais.'
                  : 'Help keep our classes, meals, and cultural outings thriving.'
              }
            </p>
          </div>
          <a
            href={path('donate', locale)}
            class="bg-sun-400 text-ink hover:bg-sun-500 inline-flex shrink-0 items-center gap-1.5 rounded-full px-5 py-2.5 text-xs font-extrabold transition-colors"
          >
            <span aria-hidden="true">♥</span>
            <span>{t('nav.donate')}</span>
          </a>
        </div>
      </div>
    </Section>
  </article>
</BaseLayout>
