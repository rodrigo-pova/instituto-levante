---
import Section from '@/components/Section.astro';
import type { Locale } from '@/i18n/config';
import { path, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={t('404.title')}
  description={t('404.description')}
  routeKey="notFound"
  noindex={true}
>
  <Section bg="warm" class="py-20 sm:py-28">
    <div
      class="border-ink/10 bg-surface mx-auto max-w-lg rounded-3xl border p-8 text-center shadow-sm sm:p-12"
    >
      <p class="text-coral-500 text-5xl font-extrabold">404</p>
      <h1
        class="text-ink mt-4 text-2xl font-extrabold tracking-tight sm:text-3xl"
      >
        {t('404.title')}
      </h1>
      <p class="text-ink-muted mt-3 text-base">
        {t('404.description')}
      </p>
      <div class="mt-8">
        <a
          href={path('home', locale)}
          class="bg-coral-600 hover:bg-coral-700 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-extrabold text-white transition-colors"
        >
          <span>{t('404.backHome')}</span>
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>
