---
import Section from '@/components/Section.astro';
import type { Locale } from '@/i18n/config';
import { path, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={t('404.title')}
  description={t('404.description')}
  routeKey="notFound"
  noindex={true}
>
  <Section bg="warm" class="py-20 sm:py-28">
    <div class="mx-auto max-w-lg rounded-3xl border border-ink/10 bg-surface p-8 text-center shadow-sm sm:p-12">
      <p class="text-5xl font-extrabold text-coral-500">404</p>
      <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">
        {t('404.title')}
      </h1>
      <p class="mt-3 text-base text-ink-muted">
        {t('404.description')}
      </p>
      <div class="mt-8">
        <a
          href={path('home', locale)}
          class="inline-flex items-center gap-2 rounded-full bg-coral-600 px-6 py-3 text-sm font-extrabold text-white transition-colors hover:bg-coral-700"
        >
          <span>{t('404.backHome')}</span>
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>
