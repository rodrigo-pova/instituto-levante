---
import ContactForm from '@/components/ContactForm.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import type { Locale } from '@/i18n/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPage } from '@/lib/content';
import { settings } from '@/lib/settings';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pageEntry = await getPage('contactPage', locale);
const data = pageEntry.data;
---

<BaseLayout
  locale={locale}
  title={data.title}
  description={data.intro}
  routeKey="contact"
>
  <Hero title={data.title} subtitle={data.intro} variant="coral" />

  <Section bg="white">
    <div class="grid gap-10 lg:grid-cols-12">
      <!-- Contact Info Column -->
      <div class="space-y-6 lg:col-span-5">
        <div
          class="border-ink/10 bg-surface-warm rounded-3xl border p-6 sm:p-8"
        >
          <h2 class="text-ink text-xl font-extrabold">
            {
              data.locationTitle ||
                (locale === 'pt-br' ? 'Onde Estamos' : 'Where to Find Us')
            }
          </h2>
          {
            data.locationText && (
              <p class="text-ink-muted mt-2 text-sm leading-relaxed">
                {data.locationText}
              </p>
            )
          }

          <dl class="border-ink/10 mt-6 space-y-4 border-t pt-5 text-sm">
            <div>
              <dt
                class="text-mint-700 text-xs font-extrabold tracking-wider uppercase"
              >
                {locale === 'pt-br' ? 'Local das Aulas' : 'Beach Location'}
              </dt>
              <dd class="text-ink mt-1 font-semibold">{settings.address}</dd>
            </div>
            <div>
              <dt
                class="text-mint-700 text-xs font-extrabold tracking-wider uppercase"
              >
                {locale === 'pt-br' ? 'Horários' : 'Schedule'}
              </dt>
              <dd class="text-ink-muted mt-1">{settings.classSchedule}</dd>
            </div>
            <div>
              <dt
                class="text-mint-700 text-xs font-extrabold tracking-wider uppercase"
              >
                E-mail
              </dt>
              <dd class="mt-1">
                <a
                  href={`mailto:${settings.email}`}
                  class="text-coral-600 font-bold hover:underline"
                >
                  {settings.email}
                </a>
              </dd>
            </div>
            <div>
              <dt
                class="text-mint-700 text-xs font-extrabold tracking-wider uppercase"
              >
                {
                  locale === 'pt-br'
                    ? 'Parcerias & Patrocínio'
                    : 'Partnerships & Grants'
                }
              </dt>
              <dd class="mt-1">
                <a
                  href={`mailto:${settings.partnershipsEmail}`}
                  class="text-coral-600 font-bold hover:underline"
                >
                  {settings.partnershipsEmail}
                </a>
              </dd>
            </div>
            <div>
              <dt
                class="text-mint-700 text-xs font-extrabold tracking-wider uppercase"
              >
                {
                  locale === 'pt-br'
                    ? 'Telefone / WhatsApp'
                    : 'Phone / WhatsApp'
                }
              </dt>
              <dd class="text-ink mt-1 font-semibold">{settings.phone}</dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Form Column -->
      <div class="lg:col-span-7">
        <ContactForm locale={locale} />
      </div>
    </div>
  </Section>
</BaseLayout>
