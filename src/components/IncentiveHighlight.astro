---
export interface IncentiveStep {
  number: string;
  title: string;
  description: string;
}

export interface Props {
  badge: string;
  title: string;
  body: string;
  steps: IncentiveStep[];
  callout?: string;
}

const { badge, title, body, steps, callout } = Astro.props;
---

<div class="rounded-3xl border-2 border-mint-400/50 bg-mint-50 p-6 sm:p-10 lg:p-12">
  <div class="max-w-3xl">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-mint-400 px-3.5 py-1 text-xs font-extrabold tracking-wide uppercase text-ink">
      {badge}
    </span>
    <h2 class="mt-4 text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">
      {title}
    </h2>
    <p class="mt-3 text-base leading-relaxed text-ink/90">
      {body}
    </p>
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      steps.map((step) => (
        <div class="flex flex-col rounded-2xl border border-mint-400/30 bg-surface p-5 shadow-2xs">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-coral-500 text-xs font-extrabold text-white">
            {step.number}
          </span>
          <h3 class="mt-4 text-base font-extrabold text-ink">{step.title}</h3>
          <p class="mt-2 text-xs leading-relaxed text-ink-muted">
            {step.description}
          </p>
        </div>
      ))
    }
  </div>

  {
    callout && (
      <div class="mt-8 flex flex-col items-start justify-between gap-4 rounded-2xl border border-ink/10 bg-surface p-5 sm:flex-row sm:items-center">
        <p class="text-sm font-semibold text-ink">{callout}</p>
        <a
          href="#formulario-parceria"
          class="shrink-0 rounded-full bg-coral-600 px-5 py-2.5 text-xs font-extrabold text-white transition-colors hover:bg-coral-700"
        >
          Falar com Especialista →
        </a>
      </div>
    )
  }
</div>
