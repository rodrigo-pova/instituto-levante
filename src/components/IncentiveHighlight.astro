---
export interface IncentiveStep {
  number: string;
  title: string;
  description: string;
}

export interface Props {
  badge: string;
  title: string;
  body: string;
  steps: IncentiveStep[];
  callout?: string;
}

const { badge, title, body, steps, callout } = Astro.props;
---

<div
  class="border-mint-400/50 bg-mint-50 rounded-3xl border-2 p-6 sm:p-10 lg:p-12"
>
  <div class="max-w-3xl">
    <span
      class="bg-mint-400 text-ink inline-flex items-center gap-1.5 rounded-full px-3.5 py-1 text-xs font-extrabold tracking-wide uppercase"
    >
      {badge}
    </span>
    <h2
      class="text-ink mt-4 text-2xl font-extrabold tracking-tight sm:text-3xl"
    >
      {title}
    </h2>
    <p class="text-ink/90 mt-3 text-base leading-relaxed">
      {body}
    </p>
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      steps.map((step) => (
        <div class="border-mint-400/30 bg-surface flex flex-col rounded-2xl border p-5 shadow-2xs">
          <span class="bg-coral-500 inline-flex h-9 w-9 items-center justify-center rounded-xl text-xs font-extrabold text-white">
            {step.number}
          </span>
          <h3 class="text-ink mt-4 text-base font-extrabold">{step.title}</h3>
          <p class="text-ink-muted mt-2 text-xs leading-relaxed">
            {step.description}
          </p>
        </div>
      ))
    }
  </div>

  {
    callout && (
      <div class="border-ink/10 bg-surface mt-8 flex flex-col items-start justify-between gap-4 rounded-2xl border p-5 sm:flex-row sm:items-center">
        <p class="text-ink text-sm font-semibold">{callout}</p>
        <a
          href="#formulario-parceria"
          class="bg-coral-600 hover:bg-coral-700 shrink-0 rounded-full px-5 py-2.5 text-xs font-extrabold text-white transition-colors"
        >
          Falar com Especialista →
        </a>
      </div>
    )
  }
</div>
