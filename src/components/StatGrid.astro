---
export interface StatItem {
  value: string;
  label: string;
  sublabel?: string;
}

export interface Props {
  stats: StatItem[];
}

const { stats } = Astro.props;
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {
    stats.map((stat, idx) => {
      const accents = [
        'border-t-coral-500',
        'border-t-mint-400',
        'border-t-sun-400',
        'border-t-lilac-400',
      ];
      return (
        <div
          class:list={[
            'border-ink/10 bg-surface rounded-2xl border border-t-4 p-6 shadow-xs',
            accents[idx % accents.length],
          ]}
        >
          <p class="text-ink text-3xl font-extrabold tracking-tight sm:text-4xl">
            {stat.value}
          </p>
          <p class="text-ink mt-2 text-sm font-bold">{stat.label}</p>
          {stat.sublabel && (
            <p class="text-ink-muted mt-1 text-xs font-medium">
              {stat.sublabel}
            </p>
          )}
        </div>
      );
    })
  }
</div>
