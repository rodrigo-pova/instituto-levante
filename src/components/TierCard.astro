---
import type { TierKey } from '@/content.config';
import type { Locale } from '@/i18n/config';

export interface Props {
  locale: Locale;
  tierKey: TierKey;
  name: string;
  price?: string;
  benefits: string[];
  highlighted?: boolean;
}

const {
  locale,
  name,
  price,
  benefits,
  highlighted = false,
} = Astro.props;

const hasPrice = Boolean(price && price.trim() !== '');
const fallbackPriceLabel =
  locale === 'pt-br' ? 'Investimento sob consulta' : 'Custom investment — contact us';
const ctaLabel =
  locale === 'pt-br' ? 'Solicitar esta cota' : 'Inquire about this tier';
---

<article
  class:list={[
    'flex flex-col justify-between rounded-3xl p-6 transition-all sm:p-7',
    highlighted
      ? 'border-2 border-coral-500 bg-surface shadow-lg ring-4 ring-coral-50'
      : 'border border-ink/10 bg-surface shadow-xs',
  ]}
>
  <div>
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-xl font-extrabold text-ink">{name}</h3>
      {
        highlighted && (
          <span class="rounded-full bg-sun-400 px-3 py-0.5 text-[11px] font-extrabold tracking-wide uppercase text-ink">
            {locale === 'pt-br' ? 'Mais Procurada' : 'Most Popular'}
          </span>
        )
      }
    </div>

    <p
      class:list={[
        'mt-3 text-sm font-bold',
        hasPrice ? 'text-2xl text-ink' : 'text-mint-700',
      ]}
    >
      {hasPrice ? price : fallbackPriceLabel}
    </p>

    <ul class="mt-6 space-y-3 border-t border-ink/10 pt-5 text-sm text-ink/90">
      {
        benefits.map((benefit) => (
          <li class="flex items-start gap-2.5">
            <span
              class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-mint-400/30 text-xs font-extrabold text-mint-800"
              aria-hidden="true"
            >
              ✓
            </span>
            <span class="leading-snug">{benefit}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mt-8 pt-4">
    <a
      href="#formulario-parceria"
      class:list={[
        'block w-full rounded-full py-3 text-center text-sm font-extrabold transition-colors',
        highlighted
          ? 'bg-coral-600 text-white hover:bg-coral-700'
          : 'bg-surface-warm text-ink border border-ink/15 hover:bg-mint-400 hover:border-mint-400',
      ]}
    >
      {ctaLabel}
    </a>
  </div>
</article>
