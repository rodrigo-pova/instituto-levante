---
export interface Props {
  badge?: string;
  title: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
  highlighted?: boolean;
}

const {
  badge,
  title,
  body,
  ctaLabel,
  ctaHref,
  highlighted = false,
} = Astro.props;
---

<div
  class:list={[
    'flex flex-col justify-between rounded-3xl p-6 sm:p-8',
    highlighted
      ? 'border-2 border-mint-400 bg-mint-50 shadow-md'
      : 'border border-ink/10 bg-surface-warm shadow-xs',
  ]}
>
  <div>
    {
      badge && (
        <span class="inline-block rounded-full bg-mint-400 px-3.5 py-1 text-xs font-extrabold tracking-wide uppercase text-ink">
          {badge}
        </span>
      )
    }
    <h2 class="mt-3 text-xl font-extrabold text-ink sm:text-2xl">{title}</h2>
    <p class="mt-2.5 text-sm leading-relaxed text-ink/85 sm:text-base">
      {body}
    </p>
  </div>

  <div class="mt-6">
    <a
      href={ctaHref}
      data-track="donate-international-inquiry"
      class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-extrabold text-white transition-colors hover:bg-coral-600"
    >
      <span>{ctaLabel}</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>
