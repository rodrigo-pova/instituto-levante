---
export interface Props {
  badge?: string;
  title: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
  highlighted?: boolean;
}

const {
  badge,
  title,
  body,
  ctaLabel,
  ctaHref,
  highlighted = false,
} = Astro.props;
---

<div
  class:list={[
    'flex flex-col justify-between rounded-3xl p-6 sm:p-8',
    highlighted
      ? 'border-mint-400 bg-mint-50 border-2 shadow-md'
      : 'border-ink/10 bg-surface-warm border shadow-xs',
  ]}
>
  <div>
    {
      badge && (
        <span class="bg-mint-400 text-ink inline-block rounded-full px-3.5 py-1 text-xs font-extrabold tracking-wide uppercase">
          {badge}
        </span>
      )
    }
    <h2 class="text-ink mt-3 text-xl font-extrabold sm:text-2xl">{title}</h2>
    <p class="text-ink/85 mt-2.5 text-sm leading-relaxed sm:text-base">
      {body}
    </p>
  </div>

  <div class="mt-6">
    <a
      href={ctaHref}
      data-track="donate-international-inquiry"
      class="bg-ink hover:bg-coral-600 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-extrabold text-white transition-colors"
    >
      <span>{ctaLabel}</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>
