---
export interface Props {
  badge: string;
  title: string;
  story: string;
  quote?: string;
  memberName?: string;
  memberRole?: string;
  cta?: { label: string; href: string };
}

const { badge, title, story, quote, memberName, memberRole, cta } = Astro.props;
---

<div class="relative overflow-hidden rounded-3xl border-2 border-sun-400 bg-surface-warm p-8 shadow-sm sm:p-10">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-16 -right-16 h-56 w-56 rounded-full bg-sun-400/25 blur-2xl"
  >
  </div>

  <div class="relative grid items-center gap-8 lg:grid-cols-12">
    <div class:list={[quote ? 'lg:col-span-7' : 'lg:col-span-12']}>
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-sun-400 px-3.5 py-1 text-xs font-extrabold tracking-wide uppercase text-ink"
      >
        <span aria-hidden="true">★</span>
        <span>{badge}</span>
      </span>
      <h2 class="mt-4 text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">
        {title}
      </h2>
      <p class="mt-3 text-base leading-relaxed text-ink-muted">
        {story}
      </p>
      {
        cta && (
          <div class="mt-6">
            <a
              href={cta.href}
              class="inline-flex items-center gap-2 rounded-full bg-coral-600 px-5 py-2.5 text-sm font-extrabold text-white transition-colors hover:bg-coral-700"
            >
              <span>{cta.label}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        )
      }
    </div>

    {
      quote && (
        <div class="lg:col-span-5">
          <blockquote class="rounded-2xl border border-ink/10 bg-surface p-6 shadow-xs">
            <p class="text-base font-medium italic leading-relaxed text-ink">
              “{quote}”
            </p>
            {(memberName || memberRole) && (
              <footer class="mt-4 border-t border-ink/10 pt-3">
                {memberName && (
                  <p class="text-sm font-extrabold text-ink">{memberName}</p>
                )}
                {memberRole && (
                  <p class="text-xs font-semibold text-mint-700">{memberRole}</p>
                )}
              </footer>
            )}
          </blockquote>
        </div>
      )
    }
  </div>
</div>
