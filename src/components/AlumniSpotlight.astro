---
export interface Props {
  badge: string;
  title: string;
  story: string;
  quote?: string;
  memberName?: string;
  memberRole?: string;
  cta?: { label: string; href: string };
}

const { badge, title, story, quote, memberName, memberRole, cta } = Astro.props;
---

<div
  class="border-sun-400 bg-surface-warm relative overflow-hidden rounded-3xl border-2 p-8 shadow-sm sm:p-10"
>
  <div
    aria-hidden="true"
    class="bg-sun-400/25 pointer-events-none absolute -top-16 -right-16 h-56 w-56 rounded-full blur-2xl"
  >
  </div>

  <div class="relative grid items-center gap-8 lg:grid-cols-12">
    <div class:list={[quote ? 'lg:col-span-7' : 'lg:col-span-12']}>
      <span
        class="bg-sun-400 text-ink inline-flex items-center gap-1.5 rounded-full px-3.5 py-1 text-xs font-extrabold tracking-wide uppercase"
      >
        <span aria-hidden="true">★</span>
        <span>{badge}</span>
      </span>
      <h2
        class="text-ink mt-4 text-2xl font-extrabold tracking-tight sm:text-3xl"
      >
        {title}
      </h2>
      <p class="text-ink-muted mt-3 text-base leading-relaxed">
        {story}
      </p>
      {
        cta && (
          <div class="mt-6">
            <a
              href={cta.href}
              class="bg-coral-600 hover:bg-coral-700 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-extrabold text-white transition-colors"
            >
              <span>{cta.label}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        )
      }
    </div>

    {
      quote && (
        <div class="lg:col-span-5">
          <blockquote class="border-ink/10 bg-surface rounded-2xl border p-6 shadow-xs">
            <p class="text-ink text-base leading-relaxed font-medium italic">
              “{quote}”
            </p>
            {(memberName || memberRole) && (
              <footer class="border-ink/10 mt-4 border-t pt-3">
                {memberName && (
                  <p class="text-ink text-sm font-extrabold">{memberName}</p>
                )}
                {memberRole && (
                  <p class="text-mint-700 text-xs font-semibold">
                    {memberRole}
                  </p>
                )}
              </footer>
            )}
          </blockquote>
        </div>
      )
    }
  </div>
</div>
