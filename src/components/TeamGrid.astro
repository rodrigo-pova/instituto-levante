---
import type { TeamGroup } from '@/content.config';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

export interface TeamMember {
  name: string;
  role: string;
  group: TeamGroup;
  photo?: string;
  photoAlt?: string;
  bio?: string;
  isAlumni?: boolean;
  alumniNote?: string;
  order?: number;
}

export interface Props {
  locale: Locale;
  groups: Record<TeamGroup, string>;
  members: TeamMember[];
}

const { locale, groups, members } = Astro.props;
const t = useTranslations(locale);

const groupOrder: TeamGroup[] = ['founder', 'teacher', 'tutor', 'staff'];

function getInitials(name: string): string {
  const parts = name.trim().split(/\s+/);
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

const avatarPalette = [
  'bg-coral-500 text-white',
  'bg-mint-400 text-ink',
  'bg-sun-400 text-ink',
  'bg-lilac-400 text-ink',
];
---

<div class="space-y-14">
  {
    groupOrder.map((groupKey) => {
      const groupMembers = members
        .filter((m) => m.group === groupKey)
        .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

      if (groupMembers.length === 0) return null;

      return (
        <section aria-labelledby={`group-${groupKey}`}>
          <div class="mb-6 flex items-center gap-3 border-b border-ink/10 pb-3">
            <h2
              id={`group-${groupKey}`}
              class="text-xl font-extrabold tracking-tight text-ink sm:text-2xl"
            >
              {groups[groupKey]}
            </h2>
            <span class="rounded-full bg-surface-warm px-2.5 py-0.5 text-xs font-bold text-ink-muted">
              {groupMembers.length}
            </span>
          </div>

          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {groupMembers.map((member, idx) => {
              const hasPhoto = Boolean(member.photo && member.photo.trim() !== '');
              const avatarColors = avatarPalette[idx % avatarPalette.length];

              return (
                <article
                  class:list={[
                    'flex flex-col justify-between rounded-2xl bg-surface p-6 shadow-xs transition-all',
                    member.isAlumni
                      ? 'border-2 border-sun-400 ring-4 ring-sun-100'
                      : 'border border-ink/10',
                  ]}
                >
                  <div>
                    <div class="flex items-start gap-4">
                      {hasPhoto ? (
                        <img
                          src={member.photo}
                          alt={member.photoAlt || member.name}
                          width="80"
                          height="80"
                          loading="lazy"
                          decoding="async"
                          class="h-16 w-16 shrink-0 rounded-2xl border border-ink/10 object-cover"
                        />
                      ) : (
                        <div
                          class:list={[
                            'flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl text-lg font-extrabold shadow-2xs',
                            avatarColors,
                          ]}
                          aria-hidden="true"
                        >
                          {getInitials(member.name)}
                        </div>
                      )}

                      <div class="min-w-0 flex-1">
                        {member.isAlumni && (
                          <span class="mb-1.5 inline-flex items-center gap-1 rounded-full bg-sun-400 px-2.5 py-0.5 text-[11px] font-extrabold text-ink">
                            <span aria-hidden="true">★</span>
                            <span>{member.alumniNote || t('team.alumniBadge')}</span>
                          </span>
                        )}
                        <h3 class="text-lg font-extrabold text-ink">{member.name}</h3>
                        <p class="text-xs font-bold text-mint-700">{member.role}</p>
                      </div>
                    </div>

                    {member.bio && (
                      <p class="mt-4 text-sm leading-relaxed text-ink-muted">
                        {member.bio}
                      </p>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })
  }
</div>
