---
export interface PillarItem {
  icon: string;
  title: string;
  description: string;
  highlight?: string;
}

export interface Props {
  pillars: PillarItem[];
}

const { pillars } = Astro.props;

const cardThemes = [
  {
    badgeBg: 'bg-coral-500 text-white',
    pillBg: 'bg-coral-50 text-coral-700 border-coral-100',
    border: 'hover:border-coral-500/50',
  },
  {
    badgeBg: 'bg-mint-400 text-ink',
    pillBg: 'bg-mint-50 text-mint-800 border-mint-100',
    border: 'hover:border-mint-400',
  },
  {
    badgeBg: 'bg-sun-400 text-ink',
    pillBg: 'bg-sun-100 text-ink border-sun-400/40',
    border: 'hover:border-sun-400',
  },
  {
    badgeBg: 'bg-lilac-400 text-ink',
    pillBg: 'bg-lilac-50 text-lilac-800 border-lilac-100',
    border: 'hover:border-lilac-400',
  },
];
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {
    pillars.map((pillar, index) => {
      const theme = cardThemes[index % cardThemes.length];
      return (
        <article
          class:list={[
            'border-ink/10 bg-surface flex flex-col justify-between rounded-2xl border p-6 shadow-xs transition-all',
            theme.border,
          ]}
        >
          <div>
            <div class="flex items-center justify-between gap-2">
              <span
                class:list={[
                  'inline-flex h-12 w-12 items-center justify-center rounded-xl font-bold shadow-2xs',
                  theme.badgeBg,
                ]}
                aria-hidden="true"
              >
                {pillar.icon === 'volleyball' && (
                  <svg
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 3a9 9 0 0 1 6.36 15.36M3.6 9h16.8M3.6 15h16.8" />
                  </svg>
                )}
                {pillar.icon === 'utensils' && (
                  <svg
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 6v6m0 0v6m0-6h6m-6 0H6"
                    />
                    <circle cx="12" cy="12" r="9" />
                  </svg>
                )}
                {pillar.icon === 'book-open' && (
                  <svg
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                    />
                  </svg>
                )}
                {pillar.icon !== 'volleyball' &&
                  pillar.icon !== 'utensils' &&
                  pillar.icon !== 'book-open' && (
                    <svg
                      class="h-6 w-6"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"
                      />
                    </svg>
                  )}
              </span>

              {pillar.highlight && (
                <span
                  class:list={[
                    'rounded-full border px-2.5 py-0.5 text-xs font-bold',
                    theme.pillBg,
                  ]}
                >
                  {pillar.highlight}
                </span>
              )}
            </div>

            <h3 class="text-ink mt-5 text-lg font-extrabold">{pillar.title}</h3>
            <p class="text-ink-muted mt-2.5 text-sm leading-relaxed">
              {pillar.description}
            </p>
          </div>
        </article>
      );
    })
  }
</div>
