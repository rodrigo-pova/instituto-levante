---
import { settings } from '@/lib/settings';

export interface Props {
  title: string;
  body: string;
  buttonLabel: string;
}

const { title, body, buttonLabel } = Astro.props;
const url = settings.crowdfundingUrl?.trim();
const platform = settings.crowdfundingPlatform?.trim();
---

{
  url && (
    <div class="border-ink/10 bg-sun-50 flex flex-col justify-between rounded-3xl border p-6 shadow-xs sm:p-8">
      <div>
        {platform && (
          <span class="bg-sun-400 text-ink inline-block rounded-full px-3 py-1 text-xs font-extrabold tracking-wide uppercase">
            {platform}
          </span>
        )}
        <h3 class="text-ink mt-3 text-xl font-extrabold sm:text-2xl">
          {title}
        </h3>
        <p class="text-ink-muted mt-2.5 text-sm leading-relaxed">{body}</p>
      </div>
      <div class="mt-6">
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          data-track="donate-crowdfunding"
          class="bg-sun-400 text-ink hover:bg-sun-500 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-extrabold shadow-2xs transition-colors"
        >
          <span>{buttonLabel}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  )
}
