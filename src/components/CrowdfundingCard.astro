---
import { settings } from '@/lib/settings';

export interface Props {
  title: string;
  body: string;
  buttonLabel: string;
}

const { title, body, buttonLabel } = Astro.props;
const url = settings.crowdfundingUrl?.trim();
const platform = settings.crowdfundingPlatform?.trim();
---

{
  url && (
    <div class="flex flex-col justify-between rounded-3xl border border-ink/10 bg-sun-50 p-6 shadow-xs sm:p-8">
      <div>
        {platform && (
          <span class="inline-block rounded-full bg-sun-400 px-3 py-1 text-xs font-extrabold tracking-wide uppercase text-ink">
            {platform}
          </span>
        )}
        <h3 class="mt-3 text-xl font-extrabold text-ink sm:text-2xl">{title}</h3>
        <p class="mt-2.5 text-sm leading-relaxed text-ink-muted">{body}</p>
      </div>
      <div class="mt-6">
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          data-track="donate-crowdfunding"
          class="inline-flex items-center gap-2 rounded-full bg-sun-400 px-6 py-3 text-sm font-extrabold text-ink shadow-2xs transition-colors hover:bg-sun-500"
        >
          <span>{buttonLabel}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  )
}
