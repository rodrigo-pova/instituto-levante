---
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

export interface ReportItem {
  year: number;
  title: string;
  category?: string;
  file: string;
}

export interface Props {
  locale: Locale;
  reports: ReportItem[];
}

const { locale, reports } = Astro.props;
const t = useTranslations(locale);
const sortedReports = [...reports].sort((a, b) => b.year - a.year);
---

<div class="grid gap-4 sm:grid-cols-2">
  {
    sortedReports.map((report) => (
      <article class="border-ink/10 bg-surface hover:border-mint-400 flex items-center justify-between gap-4 rounded-2xl border p-5 shadow-2xs transition-all">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="bg-coral-50 text-coral-700 rounded-md px-2.5 py-0.5 text-xs font-extrabold">
              {report.year}
            </span>
            {report.category && (
              <span class="text-mint-700 text-xs font-semibold">
                {report.category}
              </span>
            )}
          </div>
          <h3 class="text-ink mt-2 text-base font-extrabold">{report.title}</h3>
        </div>

        <a
          href={report.file}
          download
          class="bg-surface-warm border-ink/15 text-ink hover:bg-sun-400 hover:border-sun-400 inline-flex shrink-0 items-center gap-1.5 rounded-full border px-4 py-2 text-xs font-extrabold transition-colors"
        >
          <span>{t('action.downloadPdf')}</span>
          <span aria-hidden="true">↓</span>
        </a>
      </article>
    ))
  }
</div>
