---
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

export interface ReportItem {
  year: number;
  title: string;
  category?: string;
  file: string;
}

export interface Props {
  locale: Locale;
  reports: ReportItem[];
}

const { locale, reports } = Astro.props;
const t = useTranslations(locale);
const sortedReports = [...reports].sort((a, b) => b.year - a.year);
---

<div class="grid gap-4 sm:grid-cols-2">
  {
    sortedReports.map((report) => (
      <article class="flex items-center justify-between gap-4 rounded-2xl border border-ink/10 bg-surface p-5 shadow-2xs transition-all hover:border-mint-400">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-md bg-coral-50 px-2.5 py-0.5 text-xs font-extrabold text-coral-700">
              {report.year}
            </span>
            {report.category && (
              <span class="text-xs font-semibold text-mint-700">
                {report.category}
              </span>
            )}
          </div>
          <h3 class="mt-2 text-base font-extrabold text-ink">{report.title}</h3>
        </div>

        <a
          href={report.file}
          download
          class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-surface-warm border border-ink/15 px-4 py-2 text-xs font-extrabold text-ink transition-colors hover:bg-sun-400 hover:border-sun-400"
        >
          <span>{t('action.downloadPdf')}</span>
          <span aria-hidden="true">↓</span>
        </a>
      </article>
    ))
  }
</div>
