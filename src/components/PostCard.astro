---
import type { Locale } from '@/i18n/config';
import { formatDate, path, useTranslations } from '@/i18n/utils';

export interface Props {
  locale: Locale;
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  cover?: string;
  coverAlt?: string;
  author?: string;
}

const { locale, slug, title, description, pubDate, cover, coverAlt, author } =
  Astro.props;
const t = useTranslations(locale);
const href = path('post', locale, slug);
---

<article
  class="group border-ink/10 bg-surface flex flex-col overflow-hidden rounded-2xl border shadow-xs transition-all hover:-translate-y-0.5 hover:shadow-md"
>
  {
    cover && (
      <a href={href} class="bg-surface-warm block overflow-hidden">
        <img
          src={cover}
          alt={coverAlt || title}
          width="800"
          height="500"
          loading="lazy"
          decoding="async"
          class="aspect-16/10 w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </a>
    )
  }
  <div class="flex flex-1 flex-col justify-between p-6">
    <div>
      <div class="text-mint-700 flex items-center gap-2 text-xs font-semibold">
        <time datetime={pubDate.toISOString()}>
          {formatDate(pubDate, locale)}
        </time>
        {
          author && (
            <>
              <span aria-hidden="true">•</span>
              <span>{author}</span>
            </>
          )
        }
      </div>
      <h3
        class="text-ink group-hover:text-coral-600 mt-2.5 text-xl font-extrabold tracking-tight"
      >
        <a href={href}>{title}</a>
      </h3>
      <p class="text-ink-muted mt-2.5 line-clamp-3 text-sm leading-relaxed">
        {description}
      </p>
    </div>

    <div class="border-ink/5 mt-5 border-t pt-3">
      <a
        href={href}
        class="text-coral-600 group-hover:text-coral-700 inline-flex items-center gap-1.5 text-sm font-extrabold"
      >
        <span>{t('action.readMore')}</span>
        <span
          aria-hidden="true"
          class="transition-transform group-hover:translate-x-0.5">→</span
        >
      </a>
    </div>
  </div>
</article>
